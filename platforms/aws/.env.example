# AWS-native Secure Agentic AI Banking Demo
# Copy to .env for local development. On EC2/ECS, prefer IAM roles and AWS Secrets Manager.
# NEVER commit real credentials.

AWS_REGION=us-east-1

# Amazon Bedrock
BEDROCK_GEN_MODEL=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# Aurora PostgreSQL / RDS PostgreSQL
DB_HOST=<your-aurora-or-rds-endpoint>
DB_PORT=5432
DB_NAME=bankdemo
DB_USER=bankapp
DB_PASSWORD=<your_database_password>
DB_SSLMODE=require

# Optional: instead of DB_USER/DB_PASSWORD, store a JSON secret in Secrets Manager:
# {"username":"bankapp","password":"...","host":"...","port":5432,"dbname":"bankdemo"}
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:bankdemo-xxxx

EMPLOYEE_ID=CSR001
EMPLOYEE_ROLE=CUSTOMER_SERVICE
