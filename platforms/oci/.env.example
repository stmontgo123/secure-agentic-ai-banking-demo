# Copy this file to .env and replace placeholders locally.
# NEVER commit the real .env file or an Oracle wallet.

DB_USER=bankapp
DB_PASSWORD=<your_database_password>
DB_DSN=<your_tns_alias>
WALLET_DIR=/path/to/your/oracle/wallet
WALLET_PASSWORD=<your_wallet_password>

EMPLOYEE_ID=CSR001
EMPLOYEE_ROLE=CUSTOMER_SERVICE

# Local Ollama endpoint. Keep this bound to localhost for the demo.
OLLAMA_URL=http://127.0.0.1:11434
GEN_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
